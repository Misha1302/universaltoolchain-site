---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const upstream = "https://github.com/Misha1302/UniversalToolchain";
const revision = "f362649872ca70cb924d5233eb965e3a71602015";
const blob = upstream + "/blob/" + revision + "/";
const source = blob + "samples/Acme.PricingLanguage/Program.cs";
const authoring = blob + "docs/language-authoring/quickstart.md";
const wist = blob + "docs/start/first-program.md";
const limitations = blob + "docs/limitations.md";
const alternatives = blob + "docs/alternatives.md";
const routing = blob + "docs/language-authoring/artifact-routing.md";
const compiler = blob + "UniversalToolchain/UniversalToolchain.LanguageSdk/LanguageCompiler.cs";
const runtime = blob + "UniversalToolchain/UniversalToolchain.Runtime/LanguageRuntime.cs";
const contributing = blob + "docs/CONTRIBUTING.md";
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="page-container">
        <div class="hero-edition">
          <span>OPEN SOURCE <span class="meta-separator">/</span> .NET LANGUAGE INFRASTRUCTURE <span class="meta-separator">/</span> ALPHA</span>
          <span class="hero-edition-no">UT—001 / COMPOSITION RECORD</span>
        </div>
        <div class="hero-layout">
          <div class="hero-copy">
            <span class="chapter-index">01 <span>/</span> THE LANGUAGE BUILD RECORD</span>
            <h1 id="hero-title">Compose the<br /><span class="headline-line">language.</span><br />Know what<br /><em>runs.</em></h1>
            <div class="hero-copy-bottom">
              <div class="lead-rule" aria-hidden="true"></div>
              <p class="hero-lead">Build a language implementation from independently authored .NET components. UniversalToolchain resolves features, typed routes and backends into an inspectable plan—then binds the runtime to that selection.</p>
              <p class="hero-clarity">Language configuration is a different problem from compiling a program.</p>
              <div class="hero-actions">
                <a class="action-primary" href="#example">Explore a real example <span aria-hidden="true">↗</span></a>
                <a class="action-quiet" href={upstream} target="_blank" rel="noopener noreferrer">View source on GitHub <span aria-hidden="true">↗</span></a>
              </div>
              <a class="wist-shortcut" href={wist} target="_blank" rel="noopener noreferrer"><span class="shortcut-mark" aria-hidden="true">↳</span> Need restricted formulas? <strong>Start with Wist</strong> <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <figure class="hero-ledger" aria-labelledby="ledger-caption">
            <div class="ledger-top">
              <div>
                <span class="ledger-brand">UT / LANGUAGE BUILD LEDGER</span>
                <span class="ledger-top-sub">SPECIMEN NO. 001 <span>—</span> SOURCE-BACKED EXPLANATION</span>
              </div>
              <span class="ledger-serial" aria-hidden="true">01<span>/</span>02</span>
            </div>
            <div class="ledger-body">
              <div class="ledger-metadata">
                <div><span>LANGUAGE</span><strong>Acme.PricingLanguage</strong></div>
                <div><span>FEATURE</span><code>acme.pricing.core</code></div>
                <div><span>ENTRY ARTIFACT</span><code>SourceText&lt;string&gt;</code></div>
              </div>
              <div class="ledger-divider-label"><span>01 / RESOLVED ARTIFACT</span><span>ONE PARSER</span></div>
              <div class="ledger-artifact"><span class="ledger-artifact-id">acme.pricing.parse</span><strong>PricingExpression</strong><span class="ledger-small-arrow" aria-hidden="true">↗</span></div>
              <div class="ledger-divider-label ledger-routes-label"><span>02 / BACKEND-SPECIFIC ROUTES</span><span>TWO EXECUTORS</span></div>
              <div class="ledger-route-stack">
                <div class="ledger-route">
                  <div class="route-number">01</div>
                  <div><span class="route-kind">INTERPRETER</span><strong>PricingExpression <span aria-hidden="true">→</span> result</strong></div>
                  <span class="route-check" aria-hidden="true">↗</span>
                </div>
                <div class="ledger-route ledger-route-compiled">
                  <div class="route-number">02</div>
                  <div><span class="route-kind">COMPILED <span>/ DELEGATE, NOT CIL</span></span><strong>PricingExpression <span aria-hidden="true">→</span> Func&lt;decimal&gt; <span aria-hidden="true">→</span> result</strong></div>
                  <span class="route-check" aria-hidden="true">↗</span>
                </div>
              </div>
              <div class="ledger-result"><span>LOCAL SAMPLE OUTPUT</span><strong>35.0 <span>:</span> 35.0</strong></div>
              <div class="ledger-source"><a href={source} target="_blank" rel="noopener noreferrer"><span class="source-arrow" aria-hidden="true">↗</span> INSPECT THE SOURCE RECORD</a><span>Program.cs / PINNED</span></div>
            </div>
            <figcaption class="ledger-caption" id="ledger-caption">NOT A BROWSER COMPILER. A source-backed illustration from the independent Acme example; no .NET compilation happens here.</figcaption>
          </figure>
        </div>
        <div class="hero-baseline"><span>THE DECISION IS THE DESIGN.</span><span>SCROLL TO INSPECT THE PLAN <span aria-hidden="true">↓</span></span></div>
      </div>
    </section>

    <section class="section distinction" id="idea" aria-labelledby="idea-title">
      <div class="page-container">
        <div class="section-topline"><span>01 / THE DISTINCTION</span><span>ONE LANGUAGE / TWO DIFFERENT CLOCKS</span></div>
        <div class="distinction-head">
          <h2 id="idea-title">Before a program runs,<br /><em>its language has to be chosen.</em></h2>
          <div class="distinction-body">
            <p>A fixed compiler pipeline can wire its stages once. When independent packages contribute features, transformations and backends, someone must decide which components fit together.</p>
            <p>UT resolves declared dependencies, ownership, ordering and typed routes before program input arrives. It produces an inspectable plan—or diagnostics when the pieces do not fit.</p>
          </div>
        </div>
        <div class="two-clocks" aria-label="Language configuration and program execution are separate processes">
          <div class="clock-track">
            <div class="clock-title"><span class="clock-id">A</span><div><strong>LANGUAGE CONFIGURATION</strong><small>CHOOSE THE IMPLEMENTATION / ONCE</small></div></div>
            <ol class="clock-steps">
              <li>Packages <span>+</span> Definition</li>
              <li>LanguageCompiler</li>
              <li>LanguagePlan</li>
              <li>LanguageRuntime</li>
            </ol>
          </div>
          <div class="clock-track clock-track-inverted">
            <div class="clock-title"><span class="clock-id">B</span><div><strong>PROGRAM EXECUTION</strong><small>FOLLOW THE SELECTED ROUTE / PER INPUT</small></div></div>
            <ol class="clock-steps">
              <li>Input artifact</li>
              <li>Typed transforms</li>
              <li>Selected executor</li>
              <li>Result</li>
            </ol>
          </div>
        </div>
        <div class="distinction-foot">
          <p><strong>Structural validation ≠ semantic proof.</strong> An accepted plan does not certify an optimizer's meaning or a plugin's safety.</p>
          <span>READ THE IMPLEMENTATION <a href={compiler} target="_blank" rel="noopener noreferrer">LanguageCompiler.cs ↗</a> <a href={runtime} target="_blank" rel="noopener noreferrer">LanguageRuntime.cs ↗</a></span>
        </div>
      </div>
    </section>

    <section class="section example-section" id="example" aria-labelledby="example-title">
      <div class="page-container">
        <div class="section-topline"><span>02 / THE EVIDENCE</span><span>INDEPENDENT LANGUAGE / REAL REPOSITORY SAMPLE</span></div>
        <div class="example-intro">
          <div>
            <span class="chapter-index">CASE STUDY / ACME.PRICINGLANGUAGE</span>
            <h2 id="example-title">The plan is<br /><em>not a metaphor.</em></h2>
          </div>
          <div class="example-desc">
            <p>Acme is a small, independent pricing language written with the generic authoring SDK. It defines its own syntax, parser and two backend executors. Only one route needs an additional transformation.</p>
            <a class="text-arrow-link" href={source} target="_blank" rel="noopener noreferrer">Examine the full Acme source <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="inspector" data-inspector>
          <div class="inspector-header">
            <div class="inspector-identity"><span class="inspector-mark">UT <span>/</span> ROUTE INSPECTOR</span><span class="inspector-sub">LANGUAGE ID: ACME.PRICINGLANGUAGE <span class="dot">·</span> SOURCE FIXTURE</span></div>
            <fieldset class="route-switch">
              <legend>SELECT AN EXPLAINED BACKEND</legend>
              <div class="route-options">
                <label><input type="radio" name="backend" value="interpreter" checked data-backend-choice /><span><b>01</b> Interpreter</span></label>
                <label><input type="radio" name="backend" value="compiled" data-backend-choice /><span><b>02</b> Compiled</span></label>
              </div>
            </fieldset>
          </div>
          <div class="inspector-main">
            <aside class="inspector-provenance">
              <span class="inspector-column-label">A / DECLARED</span>
              <dl>
                <div><dt>PACKAGE</dt><dd>Acme.PricingLanguage <small>1.0.0 — sample identity</small></dd></div>
                <div><dt>FEATURE</dt><dd><code>acme.pricing.core</code></dd></div>
                <div><dt>ENTRY</dt><dd><code>SourceText&lt;string&gt;</code></dd></div>
                <div><dt>ENABLED</dt><dd>interpreter, compiled</dd></div>
                <div><dt>POLICY</dt><dd><code>RequireDeterminism</code></dd></div>
              </dl>
              <div class="provenance-footer"><span>DECLARATIONS IN</span><a href={source} target="_blank" rel="noopener noreferrer">Program.cs ↗</a></div>
            </aside>
            <div class="inspector-path">
              <span class="inspector-column-label">B / TYPE-COMPATIBLE ROUTE</span>
              <div class="path-origin">
                <span>INPUT / SOURCE</span>
                <strong>SourceText<span>&lt;string&gt;</span></strong>
              </div>
              <div class="path-connector"><span class="connector-label">TRANSFORM / acme.pricing.parse</span></div>
              <div class="path-artifact">
                <span>ARTIFACT / CUSTOM SYNTAX</span>
                <strong>PricingExpression</strong>
                <small>Acme-owned record, not Wist IR</small>
              </div>
              <div class="path-branches">
                <ol class="route-path route-interpreter" aria-label="Interpreter source-backed route">
                  <li class="path-direct"><span>DIRECT / NO ADDITIONAL TRANSFORM</span></li>
                  <li class="path-terminal"><span>EXECUTOR / acme.pricing.interpreter</span><strong>Interpreter <span aria-hidden="true">↗</span></strong><small>PricingExpression.Evaluate() returns a decimal</small></li>
                </ol>
                <ol class="route-path route-compiled" aria-label="Compiled source-backed route">
                  <li class="path-transform"><span>TRANSFORM / acme.pricing.compile</span><strong>Func&lt;decimal&gt;</strong><small>PricingExpression.Compile() → delegate</small></li>
                  <li class="path-terminal"><span>EXECUTOR / acme.pricing.compiled</span><strong>Compiled <span aria-hidden="true">↗</span></strong><small>Invokes the delegate; not Wist CIL emission</small></li>
                </ol>
              </div>
              <p class="path-explanation" aria-live="polite" data-route-summary>Interpreter: SourceText → PricingExpression → interpreter executor. The browser is only showing a source-backed route.</p>
            </div>
            <aside class="inspector-reading">
              <span class="inspector-column-label">C / THE READING</span>
              <div class="reading-major"><span>SELECTED STRUCTURE</span><strong>ONE</strong><span>immutable language plan</span></div>
              <p>Both backend routes are recorded at language-configuration time. The runtime binds components selected by the plan; it does not choose another pipeline.</p>
              <div class="reading-caveat"><span>IMPORTANT</span><p>These are declared structural contracts. UT does not prove arbitrary extension semantics or safety.</p></div>
            </aside>
          </div>
          <div class="inspector-outcome">
            <div class="outcome-number"><span>SOURCE SAMPLE OUTPUT</span><strong>35.0 <i>:</i> 35.0</strong></div>
            <p>Reproduced once in a local .NET 10 source build, 4 Nov 2026. Not a benchmark, browser result, or proof of universal backend parity.</p>
          </div>
          <div class="inspector-bottom"><span>PRE-AUTHORED EXPLANATION <span>/</span> NOT A BROWSER COMPILER</span><a href={routing} target="_blank" rel="noopener noreferrer">READ THE TYPED ROUTE CONTRACT <span aria-hidden="true">↗</span></a></div>
        </div>
        <details class="diagnostic-note">
          <summary><span>What if the components don't fit?</span><span class="summary-icon" aria-hidden="true">+</span></summary>
          <div class="diagnostic-inner"><span class="diagnostic-code">UTL2207 / AMBIGUOUS ROUTE</span><p>The planner can reject multiple fully feasible, equally priced routes when no explicit preference exists. This is a separate <strong>hypothetical invalid configuration</strong>, not a failure observed in Acme.</p><a href={blob + "docs/language-authoring/contribution-planning.md"} target="_blank" rel="noopener noreferrer">See planning diagnostics ↗</a></div>
        </details>
      </div>
    </section>

    <section class="section paths-section" id="start" aria-labelledby="paths-title">
      <div class="page-container">
        <div class="section-topline"><span>03 / TWO STARTING POINTS</span><span>ONE FRAMEWORK / DIFFERENT PROBLEMS</span></div>
        <div class="paths-top">
          <h2 id="paths-title">Use a language.<br /><em>Or author one.</em></h2>
          <p>Start from a restricted formula in an application—or assemble an entirely different language from independent, typed contributions. Neither route is a shortcut to a full language workbench.</p>
        </div>
        <div class="paths-grid">
          <article class="path-wist">
            <div class="path-section-mark"><span>PATH / 01</span><span>REFERENCE LANGUAGE</span></div>
            <div class="wist-formula" aria-label="Illustrative Wist formula">usage <span>*</span> 0.7 <span>+</span> reliability <span>*</span> 0.3</div>
            <h3>Embed restricted<br />formulas.</h3>
            <p>Wist validates constrained expressions, reports diagnostics and compiles approved formulas to typed .NET delegates. Your host still owns authorization, side effects and isolation.</p>
            <div class="alpha-footnote"><strong>ALPHA RELEASE BOUNDARY</strong><span>Published NuGet: 0.1.0-alpha.1<br />Current source candidate: 0.1.0-alpha.7 (not on NuGet.org).</span></div>
            <a class="path-cta" href={wist} target="_blank" rel="noopener noreferrer">Wist quickstart <span aria-hidden="true">↗</span></a>
          </article>
          <article class="path-sdk">
            <div class="path-section-mark"><span>PATH / 02</span><span>INDEPENDENT LANGUAGE AUTHORING</span></div>
            <div class="sdk-typographic"><span>source.text</span><b>→</b><span>your.syntax</span><b>→</b><span>your.backend</span></div>
            <h3>Author the language<br />itself.</h3>
            <p>Define syntax artifacts, transformers, passes and backend executors as typed package contributions. The low-level alpha SDK does not require Wist's AST, Bytecode or AIR—and does not generate a grammar for you.</p>
            <div class="sdk-code">
              <span class="code-kicker">AN ACTUAL API FROM ACME / C# EXCERPT</span>
              <pre tabindex="0" role="region" aria-label="Acme SDK C sharp code excerpt"><code>var syntax = new LanguageArtifactKind&lt;PricingExpression&gt;(
    "acme.pricing.syntax");</code></pre>
              <a href={source} target="_blank" rel="noopener noreferrer">Verify in Program.cs ↗</a>
            </div>
            <a class="path-cta" href={authoring} target="_blank" rel="noopener noreferrer">Language authoring quickstart <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section boundaries" id="limits" aria-labelledby="limits-title">
      <div class="page-container">
        <div class="section-topline"><span>04 / CURRENT REALITY</span><span>EXPLICIT LIMITS ARE A FEATURE OF TRUST</span></div>
        <div class="boundaries-layout">
          <div class="boundaries-glyph" aria-hidden="true">≠</div>
          <div class="boundaries-copy">
            <h2 id="limits-title">Structure<br /><em>is not a proof.</em></h2>
            <p class="boundaries-lead">UT checks declared dependencies, ownership, typed routes and selected runtime implementations. It doesn't establish the semantic correctness, performance or safety of arbitrary extensions.</p>
            <div class="boundaries-list">
              <div><span>AVAILABLE TODAY</span><p>Typed plans and routes, exact runtime binding, Wist interpreter/CIL paths, external language authoring at low level.</p></div>
              <div><span>ALPHA / EVOLVING</span><p>Public APIs may change. High-level grammar and type-system authoring aren't provided. The newest Wist source candidate is not the published NuGet package.</p></div>
              <div><span>NOT A PROMISE</span><p>No hardened in-process sandbox. No universal backend parity. No general optimizer semantic proof.</p></div>
            </div>
            <p class="boundaries-fit">If all you need is a fixed parser and one backend, a handwritten pipeline may be the better choice. UT becomes relevant when independently owned contributions and alternative routes require explicit resolution.</p>
            <div class="boundaries-links"><a href={limitations} target="_blank" rel="noopener noreferrer">Known limitations <span aria-hidden="true">↗</span></a><a href={alternatives} target="_blank" rel="noopener noreferrer">Compare alternatives <span aria-hidden="true">↗</span></a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="closing" id="explore" aria-labelledby="closing-title">
      <div class="page-container closing-content">
        <div class="closing-head"><span>05 / BUILT IN THE OPEN</span><span>UNIVERSAL TOOLCHAIN / .NET</span></div>
        <h2 id="closing-title">Inspect the code.<br /><em>Build the next piece.</em></h2>
        <p>Read the implementation behind the diagrams, run the independent language example, or try Wist in your own .NET environment. Every architectural claim here should lead somewhere you can verify.</p>
        <a class="closing-primary" href={upstream} target="_blank" rel="noopener noreferrer">Explore UniversalToolchain on GitHub <span aria-hidden="true">↗</span></a>
        <div class="closing-secondary">
          <a href={source} target="_blank" rel="noopener noreferrer">Run the Acme example ↗</a>
          <a href={wist} target="_blank" rel="noopener noreferrer">Wist quickstart ↗</a>
          <a href={authoring} target="_blank" rel="noopener noreferrer">Language Authoring SDK ↗</a>
          <a href={contributing} target="_blank" rel="noopener noreferrer">Contribute ↗</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="page-container footer-layout">
      <div class="footer-logo">UT <span>/</span></div>
      <p>UNIVERSAL TOOLCHAIN <span>—</span> EXPERIMENTAL .NET LANGUAGE INFRASTRUCTURE</p>
      <div class="footer-info"><a href={upstream + "/blob/" + revision + "/LICENSE"} target="_blank" rel="noopener noreferrer">APACHE-2.0 ↗</a><span>SPECIMEN REV <a href={upstream + "/commit/" + revision} target="_blank" rel="noopener noreferrer">{revision.slice(0, 12)}</a></span></div>
    </div>
  </footer>
  <script>
    import "../scripts/site.ts";
  </script>
</BaseLayout>
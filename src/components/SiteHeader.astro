---
const base = import.meta.env.BASE_URL;
const upstream = "https://github.com/Misha1302/UniversalToolchain";
---
<header class="site-header" data-site-header>
  <div class="page-container nav-shell">
    <a class="brand" href={base} aria-label="UT / UNIVERSAL TOOLCHAIN — homepage">
      <span class="brand-glyph" aria-hidden="true">UT <span>/</span></span>
      <span class="brand-name">UNIVERSAL<br />TOOLCHAIN</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#idea">The idea</a>
      <a href="#example">The example</a>
      <a href="#start">Get started</a>
      <a href="#limits">Limitations</a>
    </nav>
    <div class="nav-actions">
      <span class="nav-edition">EXPERIMENTAL / .NET</span>
      <a class="nav-github" href={upstream} target="_blank" rel="noopener noreferrer">SOURCE <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle><span></span><span></span></button>
    </div>
  </div>
  <nav class="mobile-navigation" id="mobile-navigation" aria-label="Mobile navigation" hidden data-mobile-nav>
    <a href="#idea">The idea <span>01</span></a>
    <a href="#example">The example <span>02</span></a>
    <a href="#start">Get started <span>03</span></a>
    <a href="#limits">Limitations <span>04</span></a>
    <a href={upstream} target="_blank" rel="noopener noreferrer">View source on GitHub <span>↗</span></a>
  </nav>
</header>
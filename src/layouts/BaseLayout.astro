---
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
const { title = "UniversalToolchain — Languages, composed.", description = "A modular .NET framework for composing language implementations from independently packaged features, typed transformations and deterministic plans." } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site).href;
const social = new URL(base + "og.png", Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101714" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UniversalToolchain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta property="og:image:alt" content="UniversalToolchain — Languages, composed. Connected language modules." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
